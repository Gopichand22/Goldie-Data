# Secrets stay on the server. Never commit .env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Same random secret in Vercel and Supabase Vault. Minimum 20 characters.
CRON_SECRET=
# Indian jeweller website checks. Public rates only; no international spot feed.
JEWELLER_FEEDS=true
JEWELLER_POLL_SECONDS=900
# Free Federal Reserve RSS; relevant headlines restricted to today/yesterday IST.
FREE_FEEDS=true
MARKET_NEWS_FEEDS=true
INTERNATIONAL_SPOT=true
# Published daily mutual-fund NAVs; cached around provider ingestion times.
FUND_NAVS=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
# Local minimum 30-second cache; Supabase Cron dispatches every minute.
POLL_SECONDS=30
# Telegram is sent only when a jeweller/Mint rate or ETF NAV differs from the previous hourly check.

