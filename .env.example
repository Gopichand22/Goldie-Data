# Secrets stay on the server. Never commit .env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Same random secret in Vercel and Supabase Vault. Minimum 20 characters.
CRON_SECRET=
# Indian jeweller website checks. Public rates only; no international spot feed.
JEWELLER_FEEDS=true
JEWELLER_POLL_SECONDS=900
# Free Federal Reserve RSS; relevant headlines restricted to today/yesterday IST.
FREE_FEEDS=true
INTERNATIONAL_SPOT=true
# Optional free plan, 12-hour delay. 48 requests/day at 30-minute refresh.
NEWSDATA_API_KEY=
NEWS_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
# Free spot quotes every minute; separate optional city polling.
POLL_SECONDS=60
# Optional movement alerts; 0 disables. Measured from last alerted price.
ALERT_PERCENT=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

